<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl"
    android:padding="16dp" android:background="@drawable/widget_background">

    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:text="D" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/widget_logo" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="دبّر" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_month" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="⟳" android:textColor="@color/widget_muted" android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_balance_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المتبقي هذا الشهر" android:textColor="@color/widget_muted" android:textSize="11sp" />
                <TextView android:id="@+id/widget_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/widget_text" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/widget_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/widget_muted" android:textSize="12sp" android:background="@drawable/widget_pill" />
        </LinearLayout>
        <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
            <TextView android:id="@+id/widget_income" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/widget_expense" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_muted" android:textSize="11sp" />
            <TextView android:id="@+id/widget_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <TextView android:id="@+id/widget_btn_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/widget_btn_neutral" android:text="−  مصروف" android:textColor="@color/widget_expense" />
        <TextView android:id="@+id/widget_btn_income" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_height="44dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/widget_btn_neutral" android:text="+  دخل" android:textColor="@color/widget_income" />
        <TextView android:id="@+id/widget_btn_voice" android:layout_width="48dp" android:layout_marginStart="8dp" android:layout_height="44dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/widget_btn_neutral" android:text="🎙" />
    </LinearLayout>
</LinearLayout>
