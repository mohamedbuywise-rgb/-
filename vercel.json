{
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 21 * * *"
    }
  ],
  "functions": {
    "api/telegram-webhook.js": {
      "memory": 1536,
      "maxDuration": 60
    },
    "api/cron-daily.js": {
      "memory": 1536,
      "maxDuration": 60
    },
    "api/reports.js": {
      "memory": 1536,
      "maxDuration": 60
    },
    "api/assistant.js": {
      "memory": 1024,
      "maxDuration": 45
    }
  }
}
